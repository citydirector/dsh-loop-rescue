{
  "name": "dsh-loop-rescue",
  "version": "0.1.0",
  "description": "DSH plugin that cuts model repetition loops mid-stream, prunes the loop out of the committed message, and resumes automatically.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./detector": "./src/detector.js",
    "./package.json": "./package.json"
  },
  "files": ["src", "tools", "cordis.patch.yml", "README.md", "README.zh-CN.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/*.spec.mjs",
    "scan": "node tools/scan-session.mjs"
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "loop", "repetition", "guard"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/citydirector/dsh-loop-rescue.git" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": ">=0.1.7-alpha.1 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.1"
  }
}
